{
    "name": "helturkey/bidi",
    "description": "Unicode bidirectional text processing for Arabic and mixed-direction PHP strings",
    "keywords": [
        "arabic",
        "bidi",
        "bidirectional",
        "unicode",
        "rtl"
    ],
    "homepage": "https://github.com/helturkey/bidi",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Hussein\\": "src/"
        },
        "classmap": [],
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Hussein\\Bidirection\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=5",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
